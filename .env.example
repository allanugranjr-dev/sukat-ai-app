NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional local API overrides. The npm run dev:node and npm run dev:xampp
# modes select their backend automatically; use these only for a non-default host.
VITE_BACKEND_MODE=
# Invitation links use this canonical origin, including when an admin sends them from localhost.
VITE_PUBLIC_APP_URL=https://sukat-ai-app.vercel.app
VITE_NODE_API_URL=
VITE_XAMPP_API_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use the local deterministic simulator for local development. Set a real provider for production.
RECONSTRUCTION_PROVIDER=local
RECONSTRUCTION_API_URL=
RECONSTRUCTION_API_KEY=

# Optional transactional email and SMS delivery for invitations and order-ready updates.
# Leave providers as console for local development; in-app notifications still work.
SUKATAI_EMAIL_PROVIDER=console
RESEND_API_KEY=
SUKATAI_EMAIL_FROM="SukatAI <onboarding@resend.dev>"
SUKATAI_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SUKATAI_PUBLIC_APP_URL=https://sukat-ai-app.vercel.app
# Supabase Edge Function secret: exact app origins allowed in dressmaker invite links.
INVITATION_ALLOWED_ORIGINS=http://127.0.0.1:5173
