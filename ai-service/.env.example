# Runtime
HOST=127.0.0.1
PORT=8000
SUKATAI_AI_MODE=low_end
RECONSTRUCTION_BACKEND=anny_clad
AI_SERVICE_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_LONG_EDGE=1280
MAX_CONCURRENT_SCANS=1
ANNY_MAX_ITERATIONS=60
ANNY_EARLY_STOP_DELTA=0.002
POSE_LANDMARKER_MODEL_PATH=models/pose_landmarker_lite.task

# These legacy directories are not used by the active Anny + CLAD pipeline.
# Keep any licensed assets outside Git if another adapter is enabled later.
SMPLX_MODEL_DIR=models/smplx
PIXIE_MODEL_DIR=models/pixie
ANTHROPOMETRY_DIR=vendor/SMPL-Anthropometry
OUTPUT_DIR=output
